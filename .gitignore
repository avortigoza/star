# Dependencies (regenerated from package.json / package-lock.json)
node_modules/
mams-automation/node_modules/

# Build output (regenerated by npm run build / make build)
dist/

# Secrets - never commit these. Use the .example templates instead.
.env
mams-automation/.env
mams-automation/scripts/fetch-usage.config.json

# Runtime data - real storage figures, user accounts (with password hashes),
# and session-derived state. Not something to version-control even privately;
# the app recreates data/ on first run via server.js's existsSync check.
data/
mams-automation/data/

# Generated monthly reports - real company storage data, regenerated by
# monthly-report.js each month. Not source, no need to track.
mams-automation/reports/

# Logs
mams-automation/logs/
*.log

# Backups
backups/
*.tar.gz

# OS / editor cruft
.DS_Store
._*
*.swp

# Old Makefile backup created during earlier troubleshooting, if present
Makefile.bak
reports/
