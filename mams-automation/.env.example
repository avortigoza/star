# Copy this file to .env (same folder) and fill in real values.
# .env should NOT be committed to git / shared publicly - it holds your Gmail app password.
#
# Only scripts/monthly-report.js reads this file, and it runs on the VM
# (next to docker-compose.yml / the data/ folder). scripts/push-to-mams.js
# runs on the Mac and is configured via the MAMS_API_URL env var set in
# audit_storage_ver2.sh / crontab instead - see README-AUTOMATION.md.

# Base URL of the running MAMS Storage Audit app
MAMS_API_URL=http://localhost:5179

# Where the app's data folder lives on THIS machine (same folder docker-compose
# mounts as ./data:/var/www/mams-storage-audit/data). Leave as-is if this
# automation folder sits next to your docker-compose.yml / data folder.
MAMS_DATA_DIR=../data

# Where generated .xls / summary files get saved before emailing
MAMS_REPORTS_DIR=./reports

# --- Email (Gmail SMTP via App Password) ---
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app) - it gives you a 16-character password.
# 3. Use that here, NOT your normal Gmail password.
EMAIL_USER=youraccount@gmail.com
EMAIL_PASS=your16charapppassword

# Comma-separated list of recipients
EMAIL_TO=someone@company.com,someoneelse@company.com
